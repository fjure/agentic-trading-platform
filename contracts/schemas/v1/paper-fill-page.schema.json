{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trading-lab.invalid/schemas/v1/paper-fill-page.schema.json",
  "title": "PaperFillPage v1",
  "$defs": {
    "PaperFillPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "items",
        "nextCursor"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "const": "alpaca-paper"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/PaperFill"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Opaque keyset cursor bound to the alpaca-paper namespace, resource and account context. Never parse or persist provider identifiers. Malformed tokens return INVALID_REQUEST; changed context returns VERSION_CONFLICT."
        }
      }
    },
    "PaperFill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fillId",
        "orderId",
        "symbol",
        "side",
        "quantity",
        "price",
        "occurredAt",
        "fee",
        "currency",
        "traceId"
      ],
      "properties": {
        "fillId": {
          "$ref": "#/$defs/PaperReadId"
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "symbol": {
          "$ref": "#/$defs/PaperSymbol"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/PaperReadPositiveDecimal"
        },
        "price": {
          "$ref": "#/$defs/PaperReadPositiveDecimal"
        },
        "occurredAt": {
          "$ref": "#/$defs/PaperReadTimestamp"
        },
        "fee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 39,
          "pattern": "^(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "traceId": {
          "$ref": "#/$defs/TraceId"
        }
      },
      "description": "Local reconciled fill evidence reference, not a provider activity ID. fee is null unless an explicit per-fill fee proof exists; unknown fees are never represented by an invented zero."
    },
    "PaperReadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"
    },
    "PaperSymbol": {
      "type": "string",
      "enum": [
        "SPY",
        "QQQ"
      ]
    },
    "PaperReadPositiveDecimal": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^(?=.*[1-9])(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
    },
    "PaperReadTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 30
    },
    "TraceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "example": "4bf92f3577b34da6a3ce929d0e0e4736"
    }
  },
  "$ref": "#/$defs/PaperFillPage"
}
