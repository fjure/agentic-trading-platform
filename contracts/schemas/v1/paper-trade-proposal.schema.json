{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trading-lab.invalid/schemas/v1/paper-trade-proposal.schema.json",
  "title": "PaperTradeProposal v1",
  "$defs": {
    "PaperLimitPrice": {
      "type": "string",
      "maxLength": 28,
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,19})(?:\\.[0-9]{1,6})?$",
      "description": "Positive exact USD price; current asset tick policy is checked before planning."
    },
    "PaperQuantity": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,19})(?:\\.[0-9]{1,9})?$",
      "description": "Strictly positive exact decimal shares; at most nine fractional digits. Fractional DAY LIMIT additionally requires fresh certified asset capability."
    },
    "PaperSymbol": {
      "type": "string",
      "enum": [
        "SPY",
        "QQQ"
      ]
    },
    "PaperTradeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialGeneration",
        "accountGeneration",
        "policyVersion",
        "profileVersion",
        "limitPolicyVersion",
        "symbol",
        "side",
        "quantity",
        "limitPrice",
        "orderType",
        "timeInForce",
        "session",
        "currency",
        "expiresAt",
        "budgetVersion",
        "riskBudget",
        "proposalId",
        "operationId",
        "marketStateId",
        "proposalSource",
        "decisionId",
        "humanRequestId",
        "createdAt",
        "traceId"
      ],
      "properties": {
        "credentialGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accountGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profileVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limitPolicyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "symbol": {
          "$ref": "#/$defs/PaperSymbol"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/PaperQuantity"
        },
        "limitPrice": {
          "$ref": "#/$defs/PaperLimitPrice"
        },
        "orderType": {
          "type": "string",
          "const": "LIMIT"
        },
        "timeInForce": {
          "type": "string",
          "const": "DAY"
        },
        "session": {
          "type": "string",
          "const": "REGULAR"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 30
        },
        "budgetVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "riskBudget": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "marketStateId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "proposalSource": {
          "type": "string",
          "enum": [
            "MODEL_DECISION",
            "HUMAN_REQUEST"
          ]
        },
        "decisionId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "maxLength": 36
        },
        "humanRequestId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "maxLength": 36
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 30
        },
        "traceId": {
          "$ref": "#/$defs/TraceId"
        }
      },
      "description": "Immutable paper proposal with truthful exclusive provenance. Human proposals reference the durable human request without inventing a model decision. Domain validation binds every execution value, generation, policy/budget version and trace to the source; TTL may only narrow.",
      "if": {
        "properties": {
          "proposalSource": {
            "const": "HUMAN_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "decisionId": {
            "type": "null"
          },
          "humanRequestId": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          }
        }
      },
      "else": {
        "properties": {
          "humanRequestId": {
            "type": "null"
          },
          "decisionId": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          }
        }
      }
    },
    "PositiveBudget": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,18})?|1000000(?:\\.0{1,18})?)$",
      "description": "Exact positive decimal USD amount no greater than 1000000."
    },
    "TraceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "example": "4bf92f3577b34da6a3ce929d0e0e4736"
    }
  },
  "$ref": "#/$defs/PaperTradeProposal"
}
