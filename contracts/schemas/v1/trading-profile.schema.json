 "title":"Trading profile contract",
 "$defs":{"PositiveBudget":{"type":"string","pattern":"^(?=.*[1-9])(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,18})?|1000000(?:\\.0{1,18})?)$"},"profile":{"type":"object","additionalProperties":false,"required":["budget","currency","strategy"],"properties":{"budget":{"$ref":"#/$defs/PositiveBudget","description":"Additional held and reserved exposure cap; does not establish ledger cash."},"currency":{"const":"USD"},"strategy":{"enum":["mock-neutral","neutral-baseline"]}}}},"$ref":"#/$defs/profile"
