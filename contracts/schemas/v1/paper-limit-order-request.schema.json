{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trading-lab.invalid/schemas/v1/paper-limit-order-request.schema.json",
  "title": "PaperLimitOrderRequest v1",
  "$defs": {
    "PaperLimitOrderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialGeneration",
        "accountGeneration",
        "policyVersion",
        "profileVersion",
        "limitPolicyVersion",
        "symbol",
        "side",
        "quantity",
        "limitPrice",
        "orderType",
        "timeInForce",
        "session",
        "currency",
        "expiresAt",
        "confirmation",
        "budgetVersion",
        "riskBudget"
      ],
      "properties": {
        "credentialGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accountGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profileVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limitPolicyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "symbol": {
          "$ref": "#/$defs/PaperSymbol"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/PaperQuantity"
        },
        "limitPrice": {
          "$ref": "#/$defs/PaperLimitPrice"
        },
        "orderType": {
          "type": "string",
          "const": "LIMIT"
        },
        "timeInForce": {
          "type": "string",
          "const": "DAY"
        },
        "session": {
          "type": "string",
          "const": "REGULAR"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 30
        },
        "confirmation": {
          "type": "string",
          "const": "PLACE_PAPER_LIMIT"
        },
        "budgetVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "riskBudget": {
          "$ref": "#/$defs/PositiveBudget"
        }
      },
      "description": "Immutable human request; no direct broker submit. Uses the shared deterministic proposal, risk, reservation and execution path. SELL cannot exceed free long holdings. Server binds request ID and trace; no synthetic model decision. No notional, MARKET or fallback order."
    },
    "PaperLimitPrice": {
      "type": "string",
      "maxLength": 28,
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,19})(?:\\.[0-9]{1,6})?$",
      "description": "Positive exact USD price; current asset tick policy is checked before planning."
    },
    "PaperQuantity": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,19})(?:\\.[0-9]{1,9})?$",
      "description": "Strictly positive exact decimal shares; at most nine fractional digits. Fractional DAY LIMIT additionally requires fresh certified asset capability."
    },
    "PaperSymbol": {
      "type": "string",
      "enum": [
        "SPY",
        "QQQ"
      ]
    },
    "PositiveBudget": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,18})?|1000000(?:\\.0{1,18})?)$",
      "description": "Exact positive decimal USD amount no greater than 1000000."
    }
  },
  "$ref": "#/$defs/PaperLimitOrderRequest"
}
