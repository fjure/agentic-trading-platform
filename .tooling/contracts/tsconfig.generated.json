{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["generated-a/**/*.ts", "client-contract-fixtures.generated.ts"],
  "exclude": ["generated-a/**/*.spec.ts"]
}
